<Project Sdk="Microsoft.NET.Sdk">
	<Import Project="../../Sdk/RawSalt.Sdk/Sdk/Sdk.props" />

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    </PropertyGroup>

	<Import Project="../../Sdk/RawSalt.Sdk/Sdk/Sdk.targets" />

    <ItemGroup>
        <ProjectReference Include="../../Engine/RawSalt.Graphics.Vulkan/RawSalt.Graphics.Vulkan.csproj" />
        <ProjectReference Include="../../Engine/RawSalt.Platforms.Win32/RawSalt.Platforms.Win32.csproj" />
        <ProjectReference Include="../../Engine/RawSalt/RawSalt.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Update="*.slang">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
        <None Update="*.png">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>
</Project>
