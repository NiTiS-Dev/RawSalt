<Project>
    <PropertyGroup>
        <RawSaltRoot Condition="'$(RawSaltRoot)' == ''">$(MSBuildThisFileDirectory)../../</RawSaltRoot>
        <RawSaltGraphicsBackends Condition="'$(RawSaltGraphicsBackends)' == ''">Vulkan</RawSaltGraphicsBackends>

        <!-- Target OS: prefer RuntimeIdentifier so cross-publishing works; fall back to the build host -->
        <_RawSaltIsWindows Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win'))">true</_RawSaltIsWindows>
        <_RawSaltIsWindows Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">true</_RawSaltIsWindows>
        <_RawSaltIsLinux   Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('linux'))">true</_RawSaltIsLinux>
        <_RawSaltIsLinux   Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">true</_RawSaltIsLinux>

        <!-- Platform project list. RawSaltPlatform is kept as a compatibility alias for single-platform builds. -->
        <RawSaltPlatforms Condition="'$(RawSaltPlatforms)' == '' and '$(RawSaltPlatform)' != ''">$(RawSaltPlatform)</RawSaltPlatforms>
        <RawSaltPlatforms Condition="'$(RawSaltPlatforms)' == '' and '$(_RawSaltIsWindows)' == 'true'">Win32</RawSaltPlatforms>
        <RawSaltPlatforms Condition="'$(RawSaltPlatforms)' == '' and '$(_RawSaltIsLinux)' == 'true'">Wayland;Xlib</RawSaltPlatforms>

        <DefineConstants Condition="$(RawSaltPlatforms.Contains('Win32'))">$(DefineConstants);RAWSALT_WIN32</DefineConstants>
        <DefineConstants Condition="$(RawSaltPlatforms.Contains('Wayland'))">$(DefineConstants);RAWSALT_WAYLAND</DefineConstants>
        <DefineConstants Condition="$(RawSaltPlatforms.Contains('Xlib'))">$(DefineConstants);RAWSALT_XLIB</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <_RawSaltPlatform Include="$(RawSaltPlatforms)" />
        <_RawSaltBackend Include="$(RawSaltGraphicsBackends)" />
    </ItemGroup>

    <ItemGroup Condition="'$(RawSaltUsePackages)' != 'true'">
        <ProjectReference Include="@(_RawSaltPlatform->'$(RawSaltRoot)RawSalt.Platforms.%(Identity)/RawSalt.Platforms.%(Identity).csproj')" />
        <ProjectReference Include="@(_RawSaltBackend->'$(RawSaltRoot)RawSalt.Graphics.%(Identity)/RawSalt.Graphics.%(Identity).csproj')" />
    </ItemGroup>

    <ItemGroup Condition="'$(RawSaltUsePackages)' == 'true'">
        <PackageReference Include="@(_RawSaltPlatform->'RawSalt.Platforms.%(Identity)')" Version="$(RawSaltVersion)" />
        <PackageReference Include="@(_RawSaltBackend->'RawSalt.Graphics.%(Identity)')" Version="$(RawSaltVersion)" />
    </ItemGroup>

    <Target Name="RawSaltValidate" BeforeTargets="BeforeBuild;ResolveProjectReferences">
        <Error Condition="'$(RawSaltPlatforms)' == ''"
               Text="RawSalt: no platform project for this target OS. Set RawSaltPlatforms explicitly." />
    </Target>
</Project>